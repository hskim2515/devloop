{
  "name": "devloop",
  "private": true,
  "description": "앱 안 버그 리포트 → Claude Code 자동 수정 → 검증 → PR → 병합 → 헤드리스 화면 확인. 여러 프로젝트에 붙이는 도구 모음",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "server": "node packages/server/bin/devloop-server.mjs",
    "test": "npm test --workspaces --if-present"
  },
  "exports": {
    "./client": {
      "types": "./packages/client/types/index.d.ts",
      "import": "./packages/client/dist/devloop-client.js",
      "default": "./packages/client/dist/devloop-client.iife.js"
    },
    "./client/vue": {
      "types": "./packages/client/types/index.d.ts",
      "default": "./packages/client/dist/devloop-client.vue.js"
    },
    "./client/style.css": "./packages/client/dist/style.css",
    "./client/dist/*": "./packages/client/dist/*",
    "./package.json": "./package.json",
    "./front-check": "./packages/front-check/src/index.js",
    "./adapters/express": "./packages/adapters/express.js",
    "./client/auto": {
      "types": "./packages/client/types/index.d.ts",
      "default": "./packages/client/dist/devloop-client.auto.js"
    },
    "./vite": "./packages/vite/index.js",
    "./webpack": "./packages/webpack/index.js",
    "./webpack/bootstrap.js": "./packages/webpack/bootstrap.js",
    "./embed": "./packages/server/src/embed.js"
  },
  "version": "0.2.15",
  "bin": {
    "front-check": "packages/front-check/bin/front-check.mjs",
    "devloop-adapter": "./packages/adapters/bin/devloop-adapter.mjs"
  },
  "dependencies": {
    "pixelmatch": "^6.0.0",
    "playwright-core": "1.47.2",
    "pngjs": "^7.0.0",
    "express": "^4.19.2",
    "yaml": "^2.5.0"
  }
}
