{
  "name": "@devloop/client",
  "version": "0.2.16",
  "description": "브라우저 SDK - 콘솔·네트워크·상태 변화·화면을 모아 버그 리포트를 보내고, Claude 자동 수정 진행을 보는 UI (Web Component)",
  "type": "module",
  "main": "dist/devloop-client.js",
  "module": "dist/devloop-client.js",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/devloop-client.js",
      "default": "./dist/devloop-client.iife.js"
    },
    "./vue": {
      "types": "./types/index.d.ts",
      "import": "./dist/devloop-client.vue.js"
    },
    "./dist/*": "./dist/*"
  },
  "files": [
    "dist",
    "src",
    "types",
    "README.md"
  ],
  "scripts": {
    "build": "vite build && vite build --config vite.vue.config.js && vite build --config vite.auto.config.js",
    "dev": "vite build --watch"
  },
  "dependencies": {
    "vue": "^3.5.13",
    "html2canvas-pro": "^1.6.7"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.4",
    "vite": "^5.4.8"
  },
  "types": "types/index.d.ts"
}
